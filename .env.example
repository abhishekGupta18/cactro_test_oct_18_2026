# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL - e.g., Neon.tech, Supabase, or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/event_booking?schema=public"

# Redis (Upstash Redis or local Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRATION=7d

# Resend API Key for real email notifications
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev
